{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tagmails-selfhost",
  "main": "services/relay-worker.mjs",
  "compatibility_date": "2026-10-02",
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tagmails-selfhost",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "services/migrations"
  }],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "tagmails-selfhost-mail" }],
  "durable_objects": { "bindings": [{ "name": "DEVICE_PUSH", "class_name": "DevicePush" }] },
  "migrations": [{ "tag": "v1-device-push", "new_sqlite_classes": ["DevicePush"] }],
  "triggers": { "crons": ["* * * * *"] },
  "secrets": { "required": [
    "RESEND_API_KEY",
    "RESEND_WEBHOOK_SECRET",
    "GOOGLE_CLIENT_ID",
    "AGENT_DOMAIN",
    "PUBLIC_ORIGIN"
  ] }
}
