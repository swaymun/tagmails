{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tagmails-relay",
  "main": "services/relay-worker.mjs",
  "compatibility_date": "2026-10-02",
  "d1_databases": [{ "binding": "DB", "database_name": "tagmails-relay", "migrations_dir": "services/migrations" }],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "tagmails-relay-mail" }],
  "durable_objects": { "bindings": [{ "name": "DEVICE_PUSH", "class_name": "DevicePush" }] },
  "migrations": [{ "tag": "v1-device-push", "new_sqlite_classes": ["DevicePush"] }],
  "triggers": { "crons": ["* * * * *"] },
  // Per-IP limits for unauthenticated routes (services/rate-limit.mjs).
  "ratelimits": [
    { "name": "PUBLIC_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "AUTH_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "secrets": { "required": ["RESEND_API_KEY", "RESEND_WEBHOOK_SECRET", "GOOGLE_CLIENT_ID", "AGENT_DOMAIN", "PUBLIC_ORIGIN"] },
  "env": {
    "dev": {
      "name": "tagmails-relay-dev",
      "vars": { "SITE_ALLOWED_ORIGINS": "https://tagmails.com,https://www.tagmails.com", "BILLING_LIVE": "true", "PUBLIC_SIGNUP_ENABLED": "true", "PILOT_CODEX_MODEL": "gpt-6-sol", "ADDRESS_DOMAIN": "tagmails.com", "MAIL_DELIVERY_READY": "true", "STATUS_REACTIONS_ENABLED": "true", "CLAUDE_ROUTE_ENABLED": "true" },
      "d1_databases": [{ "binding": "DB", "database_name": "tagmails-relay-dev", "database_id": "792cbd68-83f3-4b64-b050-b62aebcb6801", "migrations_dir": "services/migrations" }],
      "r2_buckets": [{ "binding": "MAIL", "bucket_name": "tagmails-relay-mail-dev" }],
      "send_email": [{ "name": "EMAIL" }],
      "durable_objects": { "bindings": [{ "name": "DEVICE_PUSH", "class_name": "DevicePush" }] },
      "ratelimits": [
        { "name": "PUBLIC_RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 300, "period": 60 } },
        { "name": "AUTH_RATE_LIMIT", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } }
      ],
      "secrets": { "required": ["GOOGLE_CLIENT_ID", "AGENT_DOMAIN", "PUBLIC_ORIGIN", "SITE_ORIGIN", "STORAGE_KEY", "PILOT_OWNER_EMAIL"] },
      "triggers": { "crons": ["* * * * *"] }
    }
  }
}
